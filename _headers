/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://i.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://chat.iepvn.com https://challenges.cloudflare.com; frame-src https://www.youtube-nocookie.com https://challenges.cloudflare.com; connect-src 'self' https://chat.iepvn.com https://challenges.cloudflare.com; form-action 'self'; base-uri 'self'

# CSS/JS có số phiên bản (?v=...) trong HTML nên có thể lưu đệm lâu mà vẫn cập nhật ngay khi deploy bản mới
/assets/*
  Cache-Control: public, max-age=86400

# Trang HTML: luôn kiểm tra bản mới
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/ecosystem/
  Cache-Control: public, max-age=0, must-revalidate
/investmentguide/
  Cache-Control: public, max-age=0, must-revalidate
/insight/
  Cache-Control: public, max-age=0, must-revalidate

/api/*
  Cache-Control: no-store
